SLEEP_SECONDS = 0.2                 # ajusta para respetar tu calls/sec (según tu llave)\n","\n","def fetch_page(start_record: int):\n","    params = {\n","        \"apikey\": API_KEY,\n","        \"querytext\": QUERYTEXT,\n","        \"max_records\": MAX_RECORDS,\n","        \"start_record\": start_record,\n","        # sort_field y sort_order son opcionales, pero ayudan a que el paginado sea estable\n","        \"sort_field\": \"article_number\",\n","        \"sort_order\": \"asc\",\n","    }\n","    r = requests.get(BASE_URL, params=params, timeout=30)\n","\n","    # Manejo básico de rate limit / errores\n","    if r.status_code == 429:\n","        # Too Many Requests\n","        time.sleep(2)\n","        return None\n","    r.raise_for_status()\n","    return r.json()\n","\n","def normalize_authors(authors_obj):\n","    # authors viene como objeto con lista authors.authors[] según la respuesta\n","    if not authors_obj:\n","        return \"\"\n","    authors_list = authors_obj.get(\"authors\", [])\n","    names = [a.get(\"full_name\", \"\") for a in authors_list if a.get(\"full_name\")]\n","    return \"; \".join(names)\n","\n","def main():\n","    start_record = 1\n","    all_rows = []\n","\n","    first = fetch_page(start_record)\n","    if not first:\n","        print(\"No pude obtener la primera página (rate limit o error).\")\n","        return\n","\n","    totalfound = int(first.get(\"totalfound\", 0))\n","    print(f\"Total encontrados (totalfound): {totalfound}\")\n","\n","    # procesa primera página\n","    articles = first.get(\"articles\", [])\n","    while True:\n","        for a in articles:\n","            row = {\n","                \"article_number\": a.get(\"article_number\", \"\"),\n","                \"title\": a.get(\"title\", \"\"),\n","                \"authors\": normalize_authors(a.get(\"authors\")),\n","                \"publication_title\": a.get(\"publication_title\", \"\"),\n","                \"publication_year\": a.get(\"publication_year\", \"\"),\n","                \"doi\": a.get(\"doi\", \"\"),\n","                \"abstract\": a.get(\"abstract\", \"\"),\n","                \"pdf_url\": a.get(\"pdf_url\", \"\"),\n","                \"html_url\": a.get(\"html_url\", \"\"),\n","            }\n","            all_rows.append(row)\n","\n","        # siguiente página\n","        start_record += MAX_RECORDS\n","        if totalfound and start_record > totalfound:\n","            break\n","\n","        time.sleep(SLEEP_SECONDS)\n","        data = fetch_page(start_record)\n","        if not data:\n","            # si pegaste rate limit, reintenta una vez tras esperar\n","            time.sleep(2)\n","            data = fetch_page(start_record)\n","            if not data:\n","                print(\"Me detuve por rate limit persistente.\")\n","                break\n","\n","        articles = data.get(\"articles\", [])\n","        if not articles:\n","            break\n","\n","    # guarda CSV\n","    out_file = \"ieee_xplore_results.csv\"\n","    fieldnames = [\n","        \"article_number\", \"title\", \"authors\", \"publication_title\",\n","        \"publication_year\", \"doi\", \"abstract\", \"pdf_url\", \"html_url\"\n","    ]\n","    with open(out_file, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n","        writer = csv.DictWriter(f, fieldnames=fieldnames)\n","        writer.writeheader()\n","        writer.writerows(all_rows)\n","\n","    print(f\"Listo: {len(all_rows)} registros guardados en {out_file}\")\n","\n","if __name__ == \"__main__\":\n","    main()"],"metadata":{"id":"IGu8GE_SvfF5"},"execution_count":null,"outputs":[]}]}